# copia este archivo a ".env" y completa los valores
# el ".env" esta en el .gitignore, nunca se sube al repo
# lo leen los 3 componentes: mcp_server/, a2a_server/ y terminal/ (y infra/)

# --- servidor mcp (mcp_server/servidor.py) -----------------------------------
# es el unico que habla con postgres, open-meteo y el archivo de citas

# base pgvector que levanta infra/docker-compose.yml y llena infra/cargar.py
DATABASE_URL=postgresql://parachute:parachute@localhost:5436/parachute

# modelo de embeddings, corre local en CPU. tiene que ser el mismo con el que
# se lleno la tabla o los vectores no se pueden comparar
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ruta al corpus de faqs, relativa a infra/
CORPUS_FILE=Corpus_FAQs_Parachute_SA_2026.txt

# umbral de similitud coseno del filtro grueso de la herramienta de faqs
UMBRAL_SIMILITUD=0.35

# donde escucha el servidor mcp (localhost por defecto) y su ruta streamable http
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp

# segundos maximos por ejecucion de herramienta
MCP_TOOL_TIMEOUT=30

# archivo de citas. vacio = app/data/citas.json. para pruebas conviene
# apuntarlo a otro archivo, por ejemplo CITAS_FILE=app/data/citas_prueba.json
CITAS_FILE=

# --- servidor a2a (a2a_server/servidor.py) ------------------------------------
# aloja el sistema multiagente; es el unico que necesita la api key del modelo

# credenciales de groq, la consola es gratis y no pide tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# modelo de los agentes (el mismo de hdt5 y hdt6)
GROQ_MODEL=openai/gpt-oss-20b

# url del servidor mcp al que se conectan los especialistas
MCP_URL=http://127.0.0.1:8001/mcp

# donde escucha el servidor a2a y la url que publica en la agent card
A2A_HOST=127.0.0.1
A2A_PORT=8000
A2A_PUBLIC_URL=http://127.0.0.1:8000

# --- terminal (terminal/cliente_a2a.py) ----------------------------------------
# url base del agente a2a (de ahi descarga /.well-known/agent-card.json)
A2A_URL=http://127.0.0.1:8000

# segundos maximos esperando la respuesta de un turno (groq gratis puede
# hacer esperar ~40 s por el limite de tokens por minuto)
A2A_TIMEOUT=180
