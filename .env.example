# copia este archivo a ".env" y completa los valores
# el ".env" esta en el .gitignore, nunca se sube al repo
# lo leen el agente (app/), el cargador (infra/) y los evals (promptfoo)

# base pgvector que levanta infra/docker-compose.yml y llena infra/cargar.py
DATABASE_URL=postgresql://parachute:parachute@localhost:5435/parachute

# credenciales de groq, la consola es gratis y no pide tarjeta: https://console.groq.com/keys
# promptfoo usa esta misma variable para el grader (groq:...)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# modelo del agente (el mismo de hdt5). el grader de los evals se configura
# aparte en promptfooconfig.yaml con un modelo mas grande
GROQ_MODEL=openai/gpt-oss-20b

# modelo de embeddings, corre local en CPU. tiene que ser el mismo con el que
# se lleno la tabla o los vectores no se pueden comparar
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ruta al corpus de faqs, relativa a infra/
CORPUS_FILE=Corpus_FAQs_Parachute_SA_2026.txt

# umbral de similitud coseno del filtro grueso de la herramienta de faqs
UMBRAL_SIMILITUD=0.35

# python que usa promptfoo para el provider y las assertions (el del venv, que
# tiene instalado el sdk de agentes). en linux o macos: .venv/bin/python
PROMPTFOO_PYTHON=.venv/Scripts/python.exe
